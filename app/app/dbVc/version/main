import{readFile}from'node:fs/promises'
let arc={}
let add=(a,b,c)=>(arc[a]=arc[a]||{})[b]=c
add('',0,{
  async transfer(db){
    return db.begin(async client=>{
      await client.query(`
        create table"version"("version"text not null);
        insert into"version"values('0');
      `)
    })
  }
})
export default{
  arc,
  async version(db){
    return db.begin(async client=>{
      try{
        return(await client.query(`
          select"version"from"version"
        `)).rows[0].version
      }catch(e){
        if(e.code=='42P01')
          return''
        throw e
      }
    })
  },
}
