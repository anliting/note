import{parseArgs}from'util'
import Db from'../Db/main'
import version from'./version/main'
let db=new Db
try{
  let args=parseArgs({
    options:{
      to:{
        type:'string',
        short:'t',
      },
    },
  })
  let currentVersion=await version.version(db)
  console.log(`Current version is ${JSON.stringify(currentVersion)}.`)
  console.log(`Current version can be transferred to the followings:`)
  for(let v in version.arc[currentVersion])
    console.log(`${JSON.stringify(v)}`)
  if('to'in args.values){
    console.log(`Transferring to version ${JSON.stringify(args.values.to)}...`)
    await version.arc[currentVersion][args.values.to].transfer(db)
    console.log(`Transferred to version ${JSON.stringify(args.values.to)}.`)
  }
}finally{
  await db.end()
}
